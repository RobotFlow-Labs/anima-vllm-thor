# anima-thor-ui configuration — copy to .env and fill in.
# This UI manages the anima-vllm:thor-latest engine via the host docker daemon.

# --- HuggingFace (baked in so downloads are fast, no login prompts) ---
HF_TOKEN=hf_xxx_your_token_here
HF_HOME=/home/ilessio/thor-serve/models/huggingface

# --- this UI ---
ANIMA_UI_HOST=0.0.0.0
ANIMA_UI_PORT=7000

# --- the engine it drives ---
ANIMA_VLLM_IMAGE=anima-vllm:thor-latest
ANIMA_VLLM_CONTAINER=anima-vllm
ANIMA_VLLM_PORT=8000
ANIMA_VLLM_HOST=127.0.0.1
ANIMA_VLLM_CACHE=/home/ilessio/thor-vllm-cache

# --- Thor envelope (compatibility filter) ---
ANIMA_MEM_GB=128
ANIMA_BW_GBS=273
ANIMA_WEIGHT_BUDGET_GB=95

# --- self-heal: auto-serve on boot (UI restart/reboot serves this if idle) ---
# Leave empty to disable. Falls back to the last-served model if one exists.
ANIMA_AUTOSERVE_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
ANIMA_AUTOSERVE_PROFILE=latency        # latency | throughput

# --- optional API-key auth (empty = open, single-user edge default) ---
# When set, /v1 + /api require  Authorization: Bearer <key>  or  x-api-key: <key>
ANIMA_API_KEY=

# --- HF account to publish quantized models under ---
ANIMA_HF_USER=ilessio-aiflowlab
